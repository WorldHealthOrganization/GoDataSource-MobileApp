require_relative '../node_modules/react-native/scripts/react_native_pods'
# require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

platform :ios, '13.4'
prepare_react_native_project!

source 'https://github.com/CocoaPods/Specs.git'

target 'who_mobile' do
  config = use_native_modules!

  use_react_native!(
      :path => config[:reactNativePath],
      :hermes_enabled => false
    )

  pod 'SQLCipher', :modular_headers => true
  pod 'Parse'

  #pod 'RNSqlite2', :path => '../node_modules/react-native-sqlcipher-2'

  pod 'RNKeychain', :path => '../node_modules/react-native-keychain'
  pod 'TouchID', :path => '../node_modules/react-native-touch-id'
  pod 'RNBcrypt', :path => '../node_modules/react-native-bcrypt'

  target 'who_mobileTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(installer)

    installer.pods_project.targets.each do |target|

      # ✅ Fix for SQLITE_HAS_CODEC (SQLCipher)
      if target.name == "RNSqlite2"
        target.build_configurations.each do |config|
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] << 'SQLITE_HAS_CODEC=1'
        end
      end

      # ✅ Proper fix for RNZipArchive -G flag issue
      if target.name == "RNZipArchive"
        target.build_configurations.each do |config|
          ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'OTHER_LDFLAGS'].each do |key|
            flags = config.build_settings[key]

            if flags.is_a?(String)
              flags = flags.split(' ')
            end

            flags ||= []
            flags = flags.reject { |flag| flag.strip == '-G' }

            config.build_settings[key] = flags
          end
        end
      end

      # ✅ Common build settings
      target.build_configurations.each do |config|
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
          '$(inherited)',
          '_LIBCPP_ENABLE_CXX17_REMOVED_UNARY_BINARY_FUNCTION'
        ]

        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.4'
        config.build_settings['SWIFT_VERSION'] = '5.0'
      end

    end
  end
end
